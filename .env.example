# ============================================
# MoodFM 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_USER=moodfm
MYSQL_PASSWORD=moodfm_dev_password

# Redis (docker-compose redis 容器 --requirepass 用此值，healthcheck 也用)
REDIS_PASSWORD=change_me_to_a_strong_redis_password

# JWT 密钥 (运行: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change_me_to_a_long_random_jwt_secret

# Cookie 加密密钥 - AES-256-GCM，需 32 字节 Base64 编码
# 运行: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
COOKIE_ENCRYPTION_KEY=change_me_to_a_32_byte_encryption_key

# music-adapter 鉴权密钥 (backend → adapter 走 x-adapter-secret header)
# music-adapter 启动时强制校验，缺失会 fatal exit
ADAPTER_SECRET=change_me_to_a_random_adapter_secret

# LLM 配置 (默认接 DeepSeek，支持所有 OpenAI 兼容接口)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-v4-flash

# Spring Profile
# 服务器部署必须用 prod（dev 会打开 DEBUG 日志、Swagger、并在日志里输出 OTP 验证码）
# 本地开发自行改成 dev
SPRING_PROFILES_ACTIVE=prod
