# ============================================
# MoodFM 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_USER=moodfm
MYSQL_PASSWORD=moodfm_dev_password

# JWT 密钥 (运行: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change_me_to_a_long_random_jwt_secret

# Cookie 加密密钥 - AES-256-GCM，需 32 字节 Base64 编码
# 运行: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
COOKIE_ENCRYPTION_KEY=change_me_to_a_32_byte_encryption_key

# LLM 配置 (默认接 DeepSeek，支持所有 OpenAI 兼容接口)
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=mimo-v2.5-pro

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
